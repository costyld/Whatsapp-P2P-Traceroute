# Copy to .env and adjust. All optional — defaults work out of the box.

# GeoLite2 databases (free MaxMind account: https://www.maxmind.com/en/geolite2/signup)
GEO_CITY_DB=data/GeoLite2-City.mmdb
GEO_ASN_DB=data/GeoLite2-ASN.mmdb

# Capture
WIT_IFACE=            # blank = auto-detect
WIT_COUNT=0           # 0 = run until Ctrl+C
WIT_BPF=udp or tcp
WIT_RANGE_MAX_AGE=24  # hours before re-fetching Meta prefixes

# Dashboard
WIT_HOST=127.0.0.1
WIT_PORT=8000

# Local history (aggregates only; separate from PCAP/CSV/JSON output)
# WIT_HISTORY_DB=data/history.sqlite3
WIT_SESSION_IDLE_SECONDS=60
